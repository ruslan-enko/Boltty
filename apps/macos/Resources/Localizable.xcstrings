    "Boltty %@ is available" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %@ ist verfügbar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %@ está disponible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %@ est disponible"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %@が利用できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %@ 사용 가능"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %@ está disponível"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вийшов Boltty %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %@ 已推出"
          }
        }
      }
    },
    "Boltty %@ is out; you have %@. Download it, quit Boltty from the menu bar, and drag the new one into Applications." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %1$@ ist da; du hast %2$@. Lade es, beende Boltty über die Menüleiste und zieh das neue in „Programme“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Boltty %1$@ is out; you have %2$@. Download it, quit Boltty from the menu bar, and drag the new one into Applications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha salido Boltty %1$@; tienes %2$@. Descárgalo, sal de Boltty desde la barra de menús y arrastra el nuevo a Aplicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %1$@ est sorti ; vous avez %2$@. Téléchargez-le, quittez Boltty depuis la barre des menus et faites glisser le nouveau dans Applications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %1$@が出ました。現在は%2$@です。ダウンロードし、メニューバーからBolttyを終了して、新しいものを「アプリケーション」にドラッグしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %1$@이(가) 나왔습니다. 현재 버전은 %2$@입니다. 다운로드한 다음 메뉴 막대에서 Boltty를 종료하고 새 버전을 응용 프로그램으로 드래그하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saiu o Boltty %1$@; você tem o %2$@. Baixe, encerre o Boltty pela barra de menus e arraste o novo para Aplicativos."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вийшов Boltty %1$@; у вас %2$@. Завантажте його, вийдіть із Boltty через рядок меню й перетягніть новий у Програми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %1$@ 已推出；你的版本是 %2$@。下载后，从菜单栏退出 Boltty，并将新版本拖到“应用程序”。"
          }
        }
      }
    },
    "Boltty %@ is out; you have %@. Install puts it in place of this copy and opens it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %1$@ ist da; du hast %2$@. „Installieren“ ersetzt diese Kopie und öffnet sie neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Boltty %1$@ is out; you have %2$@. Install puts it in place of this copy and opens it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha salido Boltty %1$@; tienes %2$@. «Instalar» lo pone en lugar de esta copia y lo vuelve a abrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %1$@ est sorti ; vous avez %2$@. « Installer » le met à la place de cette copie et le rouvre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %1$@が出ました。現在は%2$@です。「インストール」でこのコピーと置き換えて開き直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %1$@이(가) 나왔습니다. 현재 버전은 %2$@입니다. '설치'를 누르면 이 사본을 교체하고 다시 엽니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saiu o Boltty %1$@; você tem o %2$@. “Instalar” o coloca no lugar desta cópia e o abre de novo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вийшов Boltty %1$@; у вас %2$@. «Установити» поставить його на місце цієї копії й відкриє знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty %1$@ 已推出；你的版本是 %2$@。“安装”会替换这份副本并重新打开。"
          }
        }
      }
    },
