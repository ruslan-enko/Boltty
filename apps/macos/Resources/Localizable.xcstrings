            "value" : "Fragt nur bei Aktionen, die der Prüfer von Codex für unsicher hält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo pregunta por las acciones que el revisor de Codex considera arriesgadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne demande que pour les actions que le relecteur de Codex juge risquées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
