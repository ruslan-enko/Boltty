    "Fixed when the conversation started — the session is rooted here. A new chat can start somewhere else." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Festgelegt, als die Unterhaltung begann – die Sitzung ist hier verankert. Ein neuer Chat kann woanders beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fijado cuando empezó la conversación: la sesión está anclada aquí. Un chat nuevo puede empezar en otro sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
