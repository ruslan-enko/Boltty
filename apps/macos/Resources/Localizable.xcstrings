    "From now on Boltty keeps chats for %@. Until you empty the Trash, the moved ones are kept there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab jetzt behält Boltty Chats für %@. Bis du den Papierkorb leerst, bleiben die verschobenen dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir de ahora Boltty guarda los chats %@. Hasta que vacíes la Papelera, los movidos se quedan allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désormais, Boltty garde les discussions %@. Jusqu’à ce que vous vidiez la corbeille, celles déplacées y restent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後Bolttyはチャットを%@保持します。ゴミ箱を空にするまで、移動したチャットはそこに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제부터 Boltty는 채팅을 %@ 동안 보관합니다. 휴지통을 비울 때까지 옮긴 채팅은 그곳에 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De agora em diante o Boltty guarda os chats por %@. Até você esvaziar o Lixo, os movidos ficam lá."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відтепер Boltty зберігає чати %@. Доки ви не очистите Смітник, переміщені лежатимуть там."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从现在起 Boltty 会保留聊天 %@。在你清倒废纸篓之前，移走的聊天会保留在那里。"
          }
        }
      }
    },
