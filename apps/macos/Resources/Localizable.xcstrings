    "Automatic gives a new chat to whoever has the most of their plan left: now %@. If it cannot answer, the next one does. %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ gibt einen neuen Chat dem, der am meisten von seinem Tarif übrig hat: gerade %1$@. Kann er nicht antworten, übernimmt der nächste. %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Automatic gives a new chat to whoever has the most of their plan left: now %1$@. If it cannot answer, the next one does. %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Automático» da un chat nuevo a quien le quede más plan: ahora %1$@. Si no puede responder, responde el siguiente. %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Automatique » confie une nouvelle discussion à celui à qui il reste le plus de forfait : en ce moment %1$@. S’il ne peut pas répondre, le suivant prend le relais. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」は新しいチャットをプランの残りが最も多いエージェントに渡します。今は%1$@です。答えられない場合は次のエージェントが答えます。%2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'자동'은 새 채팅을 요금제가 가장 많이 남은 에이전트에게 줍니다. 지금은 %1$@입니다. 대답할 수 없으면 다음 에이전트가 대답합니다. %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Automático” dá um novo chat a quem tem mais plano sobrando: agora %1$@. Se ele não puder responder, o próximo responde. %2$@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Автоматично» віддає новий чат тому, в кого лишилося найбільше плану: зараз це %1$@. Якщо він не зможе відповісти, відповідає наступний. %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”会把新聊天交给套餐剩余最多的智能体：现在是 %1$@。如果它无法回答，就由下一个回答。%2$@"
          }
        }
      }
    },
