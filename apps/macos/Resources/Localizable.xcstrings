        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Boltty não conseguiu confirmar se a mensagem foi enviada. Confira a conversa antes de enviar de novo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty не зміг перевірити, чи це повідомлення надіслано. Перегляньте розмову, перш ніж надсилати знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boltty 无法确认这条消息是否已发送。再次发送前请先查看对话。"
