    "Press %@ together and let go. Uses Input Monitoring, which only this shortcut needs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drück %@ zusammen und lass los. Nutzt Eingabeüberwachung, die nur dieser Kurzbefehl braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa %@ a la vez y suelta. Usa Monitorización de entrada, que solo necesita este atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur %@ ensemble puis relâchez. Utilise la Surveillance de l’entrée, nécessaire pour ce seul raccourci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を同時に押して離します。入力監視を使います（このショートカットだけに必要です）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 함께 눌렀다 떼세요. 이 단축키에만 필요한 입력 모니터링을 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione %@ juntos e solte. Usa Monitoramento de Entrada, que só este atalho precisa."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть %@ разом і відпустіть. Потрібен Моніторинг вводу — лише для цього сполучення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时按下 %@ 再松开。使用“输入监控”，只有这个快捷键需要。"
          }
        }
      }
    },
