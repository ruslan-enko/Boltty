    "%@ needs Input Monitoring: allow Boltty in System Settings › Privacy & Security › Input Monitoring." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ braucht Eingabeüberwachung: Erlaube Boltty in Systemeinstellungen › Datenschutz & Sicherheit › Eingabeüberwachung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita Monitorización de entrada: permite Boltty en Ajustes del Sistema › Privacidad y seguridad › Monitorización de entrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nécessite la Surveillance de l’entrée : autorisez Boltty dans Réglages Système › Confidentialité et sécurité › Surveillance de l’entrée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には入力監視が必要です: システム設定 › プライバシーとセキュリティ › 入力監視でBolttyを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 입력 모니터링이 필요합니다. 시스템 설정 › 개인정보 보호 및 보안 › 입력 모니터링에서 Boltty를 허용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ precisa de Monitoramento de Entrada: permita o Boltty em Ajustes do Sistema › Privacidade e Segurança › Monitoramento de Entrada."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ потребує Моніторингу вводу: дозвольте Boltty в Системних параметрах › Приватність і безпека › Моніторинг вводу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要“输入监控”：在“系统设置” › “隐私与安全性” › “输入监控”中允许 Boltty。"
          }
        }
      }
    },
    "%@ needs Input Monitoring: allow Boltty in System Settings › Privacy & Security › Input Monitoring. Until then no shortcut opens Boltty — none of the others could be registered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ braucht Eingabeüberwachung: Erlaube Boltty in Systemeinstellungen › Datenschutz & Sicherheit › Eingabeüberwachung. Bis dahin öffnet kein Kurzbefehl Boltty – keiner der anderen ließ sich registrieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita Monitorización de entrada: permite Boltty en Ajustes del Sistema › Privacidad y seguridad › Monitorización de entrada. Hasta entonces ningún atajo abre Boltty: no se pudo registrar ninguno de los otros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nécessite la Surveillance de l’entrée : autorisez Boltty dans Réglages Système › Confidentialité et sécurité › Surveillance de l’entrée. D’ici là, aucun raccourci n’ouvre Boltty — aucun des autres n’a pu être enregistré."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には入力監視が必要です: システム設定 › プライバシーとセキュリティ › 入力監視でBolttyを許可してください。それまではどのショートカットでもBolttyを開けません — ほかのショートカットも登録できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 입력 모니터링이 필요합니다. 시스템 설정 › 개인정보 보호 및 보안 › 입력 모니터링에서 Boltty를 허용하세요. 그 전까지는 어떤 단축키로도 Boltty를 열 수 없습니다 — 다른 단축키도 등록할 수 없었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ precisa de Monitoramento de Entrada: permita o Boltty em Ajustes do Sistema › Privacidade e Segurança › Monitoramento de Entrada. Até lá nenhum atalho abre o Boltty — nenhum dos outros pôde ser registrado."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ потребує Моніторингу вводу: дозвольте Boltty в Системних параметрах › Приватність і безпека › Моніторинг вводу. Доти жодне сполучення не відкриває Boltty — інші не вдалося зареєструвати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要“输入监控”：在“系统设置” › “隐私与安全性” › “输入监控”中允许 Boltty。在此之前没有快捷键能打开 Boltty — 其他快捷键都无法注册。"
          }
        }
      }
    },
    "%@ needs Input Monitoring: allow Boltty in System Settings › Privacy & Security › Input Monitoring. Until then, %@ opens Boltty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
