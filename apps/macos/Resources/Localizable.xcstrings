    "%@ This copy of Boltty is unchanged; you can download the new one from its release page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Diese Kopie von Boltty ist unverändert; die neue kannst du von ihrer Release-Seite laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Esta copia de Boltty no ha cambiado; puedes descargar la nueva desde su página de versión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cette copie de Boltty n’a pas changé ; vous pouvez télécharger la nouvelle depuis sa page de version."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ このBolttyは変更されていません。新しいものはリリースページからダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이 Boltty는 그대로입니다. 새 버전은 릴리스 페이지에서 다운로드할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Esta cópia do Boltty não mudou; você pode baixar a nova na página da versão."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ця копія Boltty не змінилася; нову можна завантажити зі сторінки випуску."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 这份 Boltty 没有改动；你可以从发布页面下载新版本。"
          }
        }
      }
    },
    "%@ already uses that shortcut." : {
      "localizations" : {
