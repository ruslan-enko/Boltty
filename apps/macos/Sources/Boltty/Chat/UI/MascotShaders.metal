static inline float silhouette(float2 p, int shape) {
  switch (shape) {
    case MascotShapeBloom: return sdBloom(p);
    case MascotShapeCapsule: return sdCapsule(p);
    case MascotShapeDaisy: return sdDaisy(p);
    case MascotShapeOrb: return sdOrb(p);
    case MascotShapeTriangle: return sdTriangle(p);
    default: return sdHex(p);
  }
}

// MARK: - Noise

static inline float3 noiseGradient(float3 cell) {
  const float3 q = float3(
    dot(cell, float3(127.1, 311.7, 74.7)),
    dot(cell, float3(269.5, 183.3, 246.1)),
    dot(cell, float3(113.5, 271.9, 124.6)));
  return -1.0 + 2.0 * fract(sin(q) * 43758.5453123);
}

static inline float gradientNoise(float3 p) {
  const float3 i = floor(p);
  const float3 f = p - i;
  const float3 w = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
  const float n000 = dot(noiseGradient(i), f);
  const float n100 = dot(noiseGradient(i + float3(1, 0, 0)), f - float3(1, 0, 0));
  const float n010 = dot(noiseGradient(i + float3(0, 1, 0)), f - float3(0, 1, 0));
  const float n110 = dot(noiseGradient(i + float3(1, 1, 0)), f - float3(1, 1, 0));
  const float n001 = dot(noiseGradient(i + float3(0, 0, 1)), f - float3(0, 0, 1));
  const float n101 = dot(noiseGradient(i + float3(1, 0, 1)), f - float3(1, 0, 1));
  const float n011 = dot(noiseGradient(i + float3(0, 1, 1)), f - float3(0, 1, 1));
  const float n111 = dot(noiseGradient(i + float3(1, 1, 1)), f - float3(1, 1, 1));
  return mix(
    mix(mix(n000, n100, w.x), mix(n010, n110, w.x), w.y),
    mix(mix(n001, n101, w.x), mix(n011, n111, w.x), w.y), w.z);
}

static inline constant float2 *outlinePoints(int shape) {
  switch (shape) {
    case MascotShapeBloom: return kBloomPolygon;
    case MascotShapeCapsule: return kCapsulePolygon;
    case MascotShapeDaisy: return kDaisyPolygon;
    case MascotShapeOrb: return kOrbPolygon;
    case MascotShapeTriangle: return kTrianglePolygon;
    default: return kHexPolygon;
  }
}

// MARK: - The body

kernel void mascotPlushField(
  device float *field [[buffer(MascotBufferIndexField)]],
  constant int &shape [[buffer(MascotBufferIndexUniforms)]],
  uint2 id [[thread_position_in_grid]]
) {
  const int size = MASCOT_FIELD_SIZE;
  if (int(id.x) >= size || int(id.y) >= size) return;
  const float spacing = 2.0 * MASCOT_FIELD_EXTENT / float(size - 1);
  const float2 p = float2(id) * spacing - MASCOT_FIELD_EXTENT;
  const float edge = silhouette(p, shape);
  float value = edge;
  if (edge < 0.0) {
    constant float2 *points = outlinePoints(shape);
    float sum = 0.0;
    float2 start = points[191];
    for (int i = 0; i < 192; ++i) {
      const float2 end = points[i];
      const float2 segment = end - start;
      const float length = max(sqrt(dot(segment, segment)), 1e-6);
      const float2 along = segment / length;
      const float2 fromStart = start - p;
      const float s0 = dot(fromStart, along);
      const float s1 = s0 + length;
      const float h = max(abs(along.x * fromStart.y - along.y * fromStart.x), 1e-5);
      sum += atan2(h * length, h * h + s0 * s1) / h;
      start = end;
    }
    value = -3.14159265 / max(sum, 1e-6);
  }
  field[1 + id.y * size + id.x] = value;
}

static inline float plushField(float2 p, Build b) {
  const float size = float(MASCOT_FIELD_SIZE);
  const float2 g = (p + MASCOT_FIELD_EXTENT) * ((size - 1.0) / (2.0 * MASCOT_FIELD_EXTENT));
  if (any(g < 0.0) || any(g > size - 1.0)) return silhouette(p, b.shape);
  const float2 cell = min(floor(g), float2(size - 2.0));
  const float2 f = g - cell;
  const int index = 1 + int(cell.y) * MASCOT_FIELD_SIZE + int(cell.x);
  const float bottom = mix(b.field[index], b.field[index + 1], f.x);
  const float top = mix(b.field[index + MASCOT_FIELD_SIZE], b.field[index + MASCOT_FIELD_SIZE + 1], f.x);
  return mix(bottom, top, f.y);
}

static inline float frontHeight(float2 p, Build b) {
  const float depth = max(-plushField(p, b), 0.0);
  return b.thickness * pow(saturate(depth / b.deepest), b.profile);
}

static inline float2 frontSlope(float2 p, Build b) {
  const float e = 0.3;
  return float2(
    frontHeight(p + float2(e, 0.0), b) - frontHeight(p - float2(e, 0.0), b),
    frontHeight(p + float2(0.0, e), b) - frontHeight(p - float2(0.0, e), b)
  ) / (2.0 * e);
}

static inline float body(float3 p, Build b) {
  const float slab = abs(p.z) - b.thickness;
  if (slab > 2.5) return slab;
  const float lift = 1.0 / b.profile;
  const float z = abs(p.z) / b.thickness;
  const float level = b.deepest * pow(z, lift) + plushField(p.xy, b);
  const float rise = lift * b.deepest / b.thickness * pow(max(z, 1e-4), lift - 1.0);
  return level / sqrt(1.0 + rise * rise);
}

static inline float3 bodyNormal(float3 p, Build b) {
  const float e = 0.12;
  const float2 k = float2(1.0, -1.0);
  return normalize(
    k.xyy * body(p + k.xyy * e, b) +
    k.yyx * body(p + k.yyx * e, b) +
    k.yxy * body(p + k.yxy * e, b) +
    k.xxx * body(p + k.xxx * e, b)
  );
}

// MARK: - Colour

static inline float3 oklabToLinear(float3 c) {
  const float l_ = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;
  const float m_ = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;
  const float s_ = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;
  const float l = l_ * l_ * l_;
  const float m = m_ * m_ * m_;
  const float s = s_ * s_ * s_;
  return float3(
    4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
    -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
  );
}

static inline float3 paletteOklab(float g, constant MascotUniforms &u) {
  const int count = int(u.shape.x);
  float3 c = u.stops[0].xyz;
  for (int i = 1; i < count; ++i) {
    const float from = u.stops[i - 1].w;
    const float to = u.stops[i].w;
    c = mix(c, u.stops[i].xyz, saturate((g - from) / max(to - from, 1e-4)));
  }
  return c;
}

static inline float3 fitToGamut(float3 lab) {
  float3 rgb = oklabToLinear(lab);
  if (all(rgb >= 0.0) && all(rgb <= 1.0)) return rgb;
  float lo = 0.0;
  float hi = 1.0;
  for (int i = 0; i < 7; ++i) {
    const float mid = 0.5 * (lo + hi);
    const float3 probe = oklabToLinear(float3(lab.x, lab.yz * mid));
    if (all(probe >= 0.0) && all(probe <= 1.0)) { lo = mid; } else { hi = mid; }
  }
  return saturate(oklabToLinear(float3(lab.x, lab.yz * lo)));
}

constant float kPigmentChroma = 1.08;

static inline float3 softTouch(float3 lab, float light, float deep) {
  const float chroma = length(lab.yz);
  float hue = atan2(lab.z, lab.y);
  const float warm = saturate(cos(hue - 1.0) * 1.6);
  const float towardRed = clamp(0.5 - hue, -0.38, 0.38);
  hue += towardRed * warm * deep;
  const float lightness = lab.x * (0.78 + 0.25 * light) * mix(1.0, 0.86, deep * deep);
  const float paling = mix(1.0, 0.93, smoothstep(0.8, 1.0, light));
  const float boosted = chroma * kPigmentChroma * paling * (1.0 + 0.85 * deep);
  return fitToGamut(float3(lightness, boosted * cos(hue), boosted * sin(hue)));
}

static inline float occlusion(float near, float mid, float far) {
  const float o = max(0.45 - near, 0.0)
    + max(1.1 - mid, 0.0) * 0.55
    + max(2.2 - far, 0.0) * 0.12;
  return saturate(1.0 - 0.34 * o);
}

static inline float gradientCoordinate(float3 p, constant MascotUniforms &u) {
  const float clock = u.body.z;
  const float phase = u.body.w;
  const float wave = 1.6 * sin(p.x * 0.19 + clock * 0.8 + phase)
    + 0.9 * sin(p.x * 0.37 - clock * 0.55 + phase * 1.7);
  const float drift = 1.3 * sin(clock * 0.35 + phase * 0.5);

  const float top = u.extent.x;
  const float bottom = u.extent.y;
  const float middle = 0.5 * (top + bottom);
  const float halfHeight = 0.5 * (top - bottom);
  const int style = int(u.shape.z + 0.5);

  if (style == MascotGradientGlow) {
    const float reach = max(halfHeight, u.extent.z) * 1.06;
    const float2 orbit = 1.6 * float2(cos(clock * 0.5 + phase), sin(clock * 0.7 + phase * 1.3));
    const float2 centre = float2(0.0, kEyeLine) + u.face.xy + orbit;
    return saturate((length(p.xy - centre) + 0.6 * (wave + drift)) / reach);
  }
  if (style == MascotGradientSweep) {
    const float turn = u.shape.w + 0.3 * sin(clock * 0.3 + phase);
    const float2 along = float2(sin(turn), -cos(turn));
    const float reach = halfHeight * abs(cos(turn)) + u.extent.z * abs(sin(turn));
    const float t = dot(p.xy - float2(0.0, middle), along);
    return saturate(0.5 + (t - wave - drift) / (2.0 * reach));
  }
  return saturate((top - (p.y + wave + drift)) / (top - bottom));
}

// MARK: - Eyes

static inline float roundedBox(float2 p, float2 extent) {
  const float r = min(extent.x, extent.y);
  const float2 q = abs(p) - extent + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

static inline float arch(float2 p, float aperture, float radius, float thickness) {
  const float2 sc = float2(sin(aperture), cos(aperture));
  p.x = abs(p.x);
  const float d = (sc.y * p.x > sc.x * p.y) ? length(p - sc * radius) : abs(length(p) - radius);
  return d - thickness;
}

static inline float2 eyeExtent(float4 eye, float4 look) {
  const float open = saturate(look.x);
  return float2(mix(1.9, 2.2, open), max(0.42, 3.85 * eye.w * open));
}

static inline float eyeDistance(float2 q, float4 eye, float4 look, float sizeScale) {
  float2 d = (q - eye.xy) / sizeScale;
  const float c = cos(eye.z);
  const float s = sin(eye.z);
  d = float2(c * d.x + s * d.y, -s * d.x + c * d.y);
  const float side = sign(eye.x);

  const float open = saturate(look.x);
  const float2 size = eyeExtent(eye, look);
  const float2 lidded = d - float2(0.0, -0.55 * (1.0 - open));
  float capsule = roundedBox(lidded, size);
  const float lid = size.y * (1.0 - 1.3 * look.w) - 0.4 * look.w * side * lidded.x;
  capsule = max(capsule, lidded.y - lid);

  const float laugh = arch(d - float2(0.0, -1.0), 1.05, 2.4, 0.72);
  const float sleep = arch(float2(d.x, 1.6 - d.y), 1.0, 2.3, 0.62);
  float shape = mix(capsule, laugh, saturate(look.y));
  shape = mix(shape, sleep, saturate(look.z));
  return shape * sizeScale;
}

// MARK: - Set into the cloth

constant float kFeatureInset = 0.12;
constant float kFeatureGroove = 0.2;
constant float kFeatureCrevice = 0.5;
constant float kFeatureEdge = 0.16;
constant float kSocketLip = 0.14;

struct Feature {
  float3 anchor;
  float3 axisX;
  float3 axisY;
  float3 axisZ;
  float scale;
  bool attached;
};

static inline Feature makeFeature(float2 centre, float scale, float margin, Build b) {
  Feature f;
  f.scale = scale;
  f.attached = plushField(centre, b) < -margin;
  const float2 slope = frontSlope(centre, b);
  f.axisZ = normalize(float3(-slope, 1.0));
  f.axisX = normalize(float3(1.0, 0.0, slope.x));
  f.axisY = cross(f.axisZ, f.axisX);
  f.anchor = float3(centre, frontHeight(centre, b));
  return f;
}

struct Features {
  Feature left;
  Feature right;
  Feature mouth;
};

static inline Features makeFeatures(Build b, constant MascotUniforms &u) {
  Features f;
  const float scale = u.face.z;
  f.left = makeFeature(u.face.xy + u.eyes[0].xy * scale, scale, 0.25, b);
  f.right = makeFeature(u.face.xy + u.eyes[1].xy * scale, scale, 0.25, b);
  const float2 gaze = (u.eyes[0].xy + u.eyes[1].xy) * 0.5;
  f.mouth = makeFeature(u.face.xy + (gaze - float2(0.0, 2.55)) * scale, scale, 1.0, b);
  return f;
}

static inline float2 eyeFrame(float3 p, Feature f, int index, constant MascotUniforms &u) {
  const float3 local = p - f.anchor;
  const float2 onFace = float2(dot(local, f.axisX), dot(local, f.axisY)) / f.scale + u.eyes[index].xy;
  return float2(eyeDistance(onFace, u.eyes[index], u.looks[index], u.face.w) * f.scale, dot(local, f.axisZ));
}

static inline float2 mouthFrame(float3 p, Feature f, constant MascotUniforms &u) {
  const float3 local = p - f.anchor;
  const float2 onFace = float2(dot(local, f.axisX), dot(local, f.axisY)) / f.scale;
  const float droop = max(u.looks[0].w, u.looks[1].w);
  const float worry = smoothstep(0.12, 0.48, droop);
  const float smile = arch(float2(onFace.x, -onFace.y), 1.12, 1.85, 0.34);
  const float frown = arch(onFace - float2(0.0, -1.3), 1.0, 1.6, 0.34);
  return float2(mix(smile, frown, worry) * f.scale, dot(local, f.axisZ));
}

static inline float enamel(float2 at) {
  const float2 w = float2(at.x + kFeatureEdge, at.y + kFeatureInset + kFeatureEdge);
  const float plug = min(max(w.x, w.y), 0.0) + length(max(w, 0.0)) - kFeatureEdge;
  return max(plug, -(at.y + 2.0));
}

static inline float socket(float2 at) {
  return max(at.x - kFeatureGroove, -(at.y + kFeatureInset + kFeatureCrevice));
}

static inline float2 smoothMax(float a, float b, float k) {
  const float h = saturate(0.5 + 0.5 * (b - a) / k);
  return float2(mix(a, b, h) + k * h * (1.0 - h), h);
}

static inline float3 sceneParts(float3 p, Build b, Features f, constant MascotUniforms &u) {
  const float3 faceCentre = float3(u.face.xy + float2(0.0, kEyeLine - 1.0) * u.face.z,
    f.left.anchor.z);
  const float aside = length(p - faceCentre) - 9.5 * u.face.z;
  if (aside > 2.3) return float3(body(p, b), aside, 0.0);
  float holes = 100.0;
  float plugs = 100.0;
  if (f.left.attached) {
    const float2 at = eyeFrame(p, f.left, 0, u);
    holes = min(holes, socket(at));
    plugs = min(plugs, enamel(at));
  }
  if (f.right.attached) {
    const float2 at = eyeFrame(p, f.right, 1, u);
    holes = min(holes, socket(at));
    plugs = min(plugs, enamel(at));
  }
  if (f.mouth.attached) {
    const float2 at = mouthFrame(p, f.mouth, u);
    holes = min(holes, socket(at));
    plugs = min(plugs, enamel(at));
  }
  const float2 cut = smoothMax(body(p, b), -holes, kSocketLip);
  return float3(cut.x, plugs, cut.y);
}

static inline float scene(float3 p, Build b, Features f, constant MascotUniforms &u) {
  const float3 parts = sceneParts(p, b, f, u);
  return min(parts.x, parts.y);
}

static inline float holes(float3 p, Features f, constant MascotUniforms &u) {
  float d = 100.0;
  if (f.left.attached) d = min(d, socket(eyeFrame(p, f.left, 0, u)));
  if (f.right.attached) d = min(d, socket(eyeFrame(p, f.right, 1, u)));
  if (f.mouth.attached) d = min(d, socket(mouthFrame(p, f.mouth, u)));
  return d;
}

static inline float eyeSockets(float3 p, Features f, constant MascotUniforms &u) {
  float d = 100.0;
  if (f.left.attached) d = min(d, socket(eyeFrame(p, f.left, 0, u)));
  if (f.right.attached) d = min(d, socket(eyeFrame(p, f.right, 1, u)));
  return d;
}

static inline float plugs(float3 p, Features f, constant MascotUniforms &u) {
  float d = 100.0;
  if (f.left.attached) d = min(d, enamel(eyeFrame(p, f.left, 0, u)));
  if (f.right.attached) d = min(d, enamel(eyeFrame(p, f.right, 1, u)));
  if (f.mouth.attached) d = min(d, enamel(mouthFrame(p, f.mouth, u)));
  return d;
}

// MARK: - The studio

struct Softbox {
  float3 direction;
  float3 up;
  float2 extent;
  float3 radiance;
};

constant int kSoftboxCount = 4;

static inline Softbox softbox(int index) {
  Softbox s;
  switch (index) {
    case 0:
      s.direction = normalize(float3(-0.48, 0.56, 0.68));
      s.up = float3(0.0, 1.0, 0.0);
      s.extent = float2(0.42, 0.3);
      s.radiance = float3(4.0, 3.9, 3.7);
      break;
    case 1:
      s.direction = normalize(float3(0.05, 1.0, 0.15));
      s.up = float3(0.0, 0.0, -1.0);
      s.extent = float2(0.8, 0.5);
      s.radiance = float3(1.3, 1.35, 1.45);
      break;
    case 2:
      s.direction = normalize(float3(0.86, 0.22, -0.46));
      s.up = float3(0.0, 1.0, 0.0);
      s.extent = float2(0.1, 0.75);
      s.radiance = float3(2.6, 2.8, 3.1);
      break;
    default:
      s.direction = normalize(float3(0.72, -0.12, 0.68));
      s.up = float3(0.0, 1.0, 0.0);
      s.extent = float2(0.45, 0.35);
      s.radiance = float3(0.55, 0.55, 0.55);
      break;
  }
  return s;
}

static inline float roundedRect(float2 p, float2 extent, float r) {
  const float2 q = abs(p) - extent + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

static inline float softboxWindow(float3 d, Softbox s, float blur) {
  const float c = dot(d, s.direction);
  if (c <= 0.05) return 0.0;
  const float3 right = normalize(cross(s.up, s.direction));
  const float3 up = cross(s.direction, right);
  const float2 uv = float2(dot(d, right), dot(d, up)) / c;
  const float edge = roundedRect(uv, s.extent, min(s.extent.x, s.extent.y) * 0.5) - blur;
  const float soft = 0.015 + blur;
  const float spread = (s.extent.x * s.extent.y) / ((s.extent.x + blur) * (s.extent.y + blur));
  return (1.0 - smoothstep(-soft, soft, edge)) * spread;
}

static inline float3 dome(float3 d) {
  const float3 ceiling = float3(0.30, 0.32, 0.36);
  const float3 horizon = float3(0.19, 0.19, 0.20);
  const float3 ground = float3(0.17, 0.13, 0.10);
  return d.y > 0.0 ? mix(horizon, ceiling, smoothstep(0.0, 0.8, d.y))
                   : mix(horizon, ground, smoothstep(0.0, 0.4, -d.y));
}

static inline float3 studio(float3 d, float blur) {
  float3 radiance = dome(d);
  for (int i = 0; i < kSoftboxCount; ++i) {
    const Softbox s = softbox(i);
    radiance += s.radiance * softboxWindow(d, s, blur);
  }
  return radiance;
}

static inline float3 studioIrradiance(float3 n) {
  float3 e = mix(dome(float3(0.0, -1.0, 0.0)), dome(float3(0.0, 1.0, 0.0)), 0.5 + 0.5 * n.y)
    * 3.14159265 * 0.9;
  for (int i = 0; i < kSoftboxCount; ++i) {
    const Softbox s = softbox(i);
    const float solidAngle = 4.0 * s.extent.x * s.extent.y / (1.0 + dot(s.extent, s.extent));
    e += s.radiance * solidAngle * saturate((dot(n, s.direction) + 0.3) / 1.3);
  }
  return e;
}

static inline float luminance(float3 c) {
  return dot(c, float3(0.2126, 0.7152, 0.0722));
}

static inline float3 rollOff(float3 c) {
  const float3 over = max(c - 0.82, 0.0);
  return min(c, 0.82) + 0.18 * (1.0 - exp(-over / 0.18));
}

// MARK: - One ray

struct MascotSample {
  float3 color;
  float coverage;
};

struct View {
  float3x3 rotation;
  float3x3 inverse;
  float3 stretch;
  float3 directionW;
};

struct Lighting {
  float lit;
  float wrap;
  float3 tint;
};

static inline Lighting light(float3 n) {
  Lighting l;
  const Softbox key = softbox(0);
  l.wrap = saturate((dot(n, key.direction) + 0.5) / 1.5);
  const float3 irradiance = studioIrradiance(n);
  const float3 keyIrradiance = studioIrradiance(key.direction);
  const float reference = luminance(keyIrradiance);
  l.lit = saturate(luminance(irradiance) / reference);
  l.tint = mix(float3(1.0),
    (irradiance / max(luminance(irradiance), 1e-4)) / (keyIrradiance / reference), 0.5);
  return l;
}

static inline float3 cloth(float3 pigment, Lighting l, float facing, float ao) {
  const float rim = pow(1.0 - facing, 2.2) * (1.0 - 0.85 * l.wrap * l.wrap);
  const float deep = saturate(smoothstep(0.22, 0.95, 1.0 - l.lit) * 0.9 + rim * 0.6 + (1.0 - ao) * 0.6);
  return softTouch(pigment, l.lit * mix(0.55, 1.0, ao), deep) * l.tint;
}

// Kept out of the march loop it is called once from (measured at 240pt and
// 1.5×: 9.7 → 4.4 ms a frame, 60pt 3.2 → 1.6). Inlined, its
// normals, studio and gamut fit held registers through every step of the
// march, and the GPU ran fewer pixels at once for it.
__attribute__((noinline))
static float3 shadeSolid(
  float3 p, View view, Build build, Features features, constant MascotUniforms &u, float underCoat
) {
  const float3 parts = sceneParts(p, build, features, u);
  const bool onEnamel = parts.y < parts.x;
  const bool onMouth = onEnamel && features.mouth.attached
    && enamel(mouthFrame(p, features.mouth, u)) <= parts.y + 1e-4;
  float3 normalObject;
  if (onEnamel) {
    const float e = 0.012;
    const float2 k = float2(1.0, -1.0);
    normalObject = normalize(
      k.xyy * plugs(p + k.xyy * e, features, u) + k.yyx * plugs(p + k.yyx * e, features, u) +
      k.yxy * plugs(p + k.yxy * e, features, u) + k.xxx * plugs(p + k.xxx * e, features, u));
  } else {
    const float3 fabric = bodyNormal(p, build);
    float3 wall = fabric;
    if (parts.z > 0.001) {
      const float e = 0.012;
      const float2 k = float2(1.0, -1.0);
      wall = -normalize(
        k.xyy * holes(p + k.xyy * e, features, u) + k.yyx * holes(p + k.yyx * e, features, u) +
        k.yxy * holes(p + k.yxy * e, features, u) + k.xxx * holes(p + k.xxx * e, features, u));
    }
    normalObject = normalize(mix(fabric, wall, parts.z));
  }
  const float3 n = normalize(view.rotation * (normalObject / view.stretch));
  const float3 v = -view.directionW;
  const float facing = saturate(dot(n, v));
  const Lighting l = light(n);

  const float3 o = normalize(normalObject);
  float probes[3];
  const float reach[3] = { 0.45, 1.1, 2.2 };
  for (int i = 0; i < 3; ++i) {
    probes[i] = scene(p + o * reach[i], build, features, u);
  }
  const float socketShade = onEnamel ? 1.0
    : mix(mix(0.5, 1.0, smoothstep(0.0, 0.5, eyeSockets(p, features, u))), 1.0, saturate(u.ink.x));
  const float ao = occlusion(probes[0], probes[1], probes[2]) * socketShade
    * (onEnamel ? 1.0 : mix(1.0, 0.45, underCoat));

  if (!onEnamel) {
    float3 color = cloth(paletteOklab(gradientCoordinate(p, u), u), l, facing, ao);
    const float sheen = saturate(u.finish.x);
    if (sheen > 0.0) {
      const float grazing = pow(1.0 - facing, 2.0);
      const float3 tipColour = mix(color, float3(1.0), 0.45);
      color = color * mix(1.0, 0.86, sheen * facing) + tipColour * grazing * 0.7 * sheen * ao;
    }
    return color;
  }

  const float black = saturate(onMouth ? u.ink.y : u.ink.x);
  const float shadeAcross = mix(0.70, 1.0, l.lit) * mix(0.55, 1.0, ao);
  const float3 white = float3(0.93) * shadeAcross * mix(float3(1.0), l.tint, 0.6) + 0.04;
  float3 color = mix(white, float3(0.0015, 0.0017, 0.002), black);
  const float3 reflected = reflect(-v, n);
  const float fresnel = 0.04 + 0.96 * pow(1.0 - facing, 5.0);
  color += studio(reflected, mix(0.25, 0.12, black)) * fresnel * mix(0.35, 0.25, black) * mix(0.3, 1.0, ao);
  return color;
}

// MARK: - Fur

constant float kFurLength = 1.25;

struct Coat {
  float3 normal;
  float3 lean;
  float3 rootColour;
  float3 tipColour;
};

static inline Coat makeCoat(float3 p, float3 n, float d, View view, constant MascotUniforms &u) {
  Coat c;
  c.normal = n;
  const float3 root = p - n * d;
  c.lean = float3(
    gradientNoise(root * 0.6),
    gradientNoise(root * 0.6 + 11.0),
    gradientNoise(root * 0.6 + 23.0)) * 0.9;
  const float3 nW = normalize(view.rotation * (n / view.stretch));
  const Lighting l = light(nW);
  const float facing = saturate(dot(nW, -view.directionW));
  const float3 pigment = paletteOklab(gradientCoordinate(root, u), u);
  c.rootColour = softTouch(pigment, l.lit * 0.3, saturate(0.65 + smoothstep(0.22, 0.95, 1.0 - l.lit) * 0.6)) * l.tint;
  const float3 tip = softTouch(pigment, l.lit, saturate(smoothstep(0.22, 0.95, 1.0 - l.lit) * 0.6)) * l.tint;
  c.tipColour = tip + mix(tip, float3(1.0), 0.5) * pow(1.0 - facing, 2.0) * 0.45;
  return c;
}

static inline float furDensity(float3 p, Coat c, float d, float height) {
  const float3 root = p - c.normal * d + c.lean * height;
  const float strand = gradientNoise(root * 6.5) + 0.4 * gradientNoise(root * 14.0 + 5.0);
  const float threshold = mix(-0.3, 0.45, height);
  return smoothstep(threshold - 0.05, threshold + 0.05, strand);
}

static MascotSample shade(float2 q, constant MascotUniforms &u, const device float *field) {
  MascotSample out;
  out.color = float3(0.0);
  out.coverage = 0.0;

  const Build build = makeBuild(u, field);
  View view;
  view.rotation = float3x3(u.axisX.xyz, u.axisY.xyz, u.axisZ.xyz);
  view.inverse = transpose(view.rotation);
  view.stretch = float3(u.body.x, u.body.y, 1.0);
  const float3 lift = float3(0.0, u.axisX.w, 0.0);

  const float3 eyeW = float3(0.0, 0.0, kCameraDistance);
  view.directionW = normalize(float3(q, build.thickness) - eyeW);
  const float3 origin = (view.inverse * (eyeW - lift)) / view.stretch;
  const float3 direction = normalize((view.inverse * view.directionW) / view.stretch);

  // The ray is marched only inside a box round the body — its outline's
  // reach, its stuffing's depth, and a margin for the fur — not a sphere
  // of 24 round all of it: a pixel whose ray misses the box is done at
  // once (the canvas holds a hop's room round the face, most of it air),
  // and one that meets it starts at the box.
  const float margin = 1.5;
  const float3 lo = float3(-u.extent.z - margin, u.extent.y - margin, -build.thickness - margin);
  const float3 hi = float3(u.extent.z + margin, u.extent.x + margin, build.thickness + margin);
  const float3 safe = select(direction, float3(1e-6), abs(direction) < 1e-6);
  const float3 near = (lo - origin) / safe;
  const float3 far = (hi - origin) / safe;
  const float3 enters = min(near, far);
  const float3 leaves = max(near, far);
  const float entry = max(max(enters.x, enters.y), enters.z);
  const float exit = min(min(leaves.x, leaves.y), leaves.z);
  if (exit < max(entry, 0.0)) { return out; }
  float t = max(entry, 0.0);
  const Features features = makeFeatures(build, u);
  const float furred = saturate(u.finish.y);
  const float coat = kFurLength * furred;
  const float stepFraction = min(u.extent.w, 0.65);

  float3 gathered = float3(0.0);
  float transmit = 1.0;
  bool solid = false;
  bool inCoat = false;
  Coat fibres;
  for (int i = 0; i < 320; ++i) {
    const float3 at = origin + direction * t;
    const float3 parts = sceneParts(at, build, features, u);
    const float d = min(parts.x, parts.y);
    if (d < 0.01) { solid = true; break; }
    if (d > coat) {
      t += max((d - coat) * stepFraction, coat > 0.0 ? 0.02 : 0.0);
    } else {
      const float dt = coat * 0.09;
      const float fabric = parts.x;
      const float clear = parts.y > 2.0 ? 1.0 : smoothstep(0.1, 0.8, holes(at, features, u));
      if (fabric > 0.0 && fabric < coat && clear > 0.0) {
        if (!inCoat) {
          fibres = makeCoat(at, bodyNormal(at, build), fabric, view, u);
          inCoat = true;
        }
        const float height = fabric / coat;
        const float density = furDensity(at, fibres, fabric, height) * clear;
        if (density > 0.001) {
          const float alpha = 1.0 - exp(-density * dt * 7.0);
          const float3 fibre = mix(fibres.rootColour, fibres.tipColour, pow(height, 0.6));
          gathered += transmit * alpha * fibre;
          transmit *= 1.0 - alpha;
          if (transmit < 0.02) { break; }
        }
      }
      t += dt;
    }
    if (t > exit) { break; }
  }

  if (solid) {
    gathered += transmit * shadeSolid(origin + direction * t, view, build, features, u, furred);
    transmit = 0.0;
  }
  const float coverage = 1.0 - transmit;
  if (coverage <= 0.0) { return out; }
  out.color = rollOff(gathered / coverage);
  out.coverage = coverage;
  return out;
}

static inline float3 encodeSRGB(float3 c) {
  c = saturate(c);
  return select(1.055 * powr(c, 1.0 / 2.4) - 0.055, 12.92 * c, c <= 0.0031308);
}

static inline float ditherNoise(float2 p) {
  return fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453) - 0.5;
}

fragment float4 mascotFragment(
  MascotVaryings in [[stage_in]],
  constant MascotUniforms &u [[buffer(MascotBufferIndexUniforms)]],
  const device float *field [[buffer(MascotBufferIndexField)]]
) {
  const float pixel = u.frame.z;
  const float unitsPerPoint = 1.0 / u.frame.w;
  const float2 offsets[4] = {
    float2(-0.125, -0.375), float2(0.375, -0.125),
    float2(0.125, 0.375), float2(-0.375, 0.125)
  };
  const int rays = u.finish.z >= 1.0 ? clamp(int(u.finish.z), 1, 4)
    : (u.finish.y > 0.0 ? 2 : 4);
  // One ray first; the rest only where this pixel's 2×2 quad disagrees —
  // the silhouette, a socket's rim, a feature's edge. Inside a smooth
  // cloth one ray is the whole answer, and that is most of the face: a big
  // face cost four times what it needed. One call
  // site for `shade`: two inlined copies doubled its registers and halved
  // the GPU's occupancy.
  float3 color = float3(0.0);
  float coverage = 0.0;
  int taken = 0;
  for (int i = 0; i < rays; ++i) {
    const MascotSample s = shade((in.local + offsets[i * (4 / rays)] * pixel) * unitsPerPoint, u, field);
    color += s.color * s.coverage;
    coverage += s.coverage;
    taken += 1;
    if (i == 0) {
      const float2 change = fwidth(float2(s.coverage, luminance(s.color) * s.coverage));
      if (change.x <= 0.001 && change.y <= 0.03) { break; }
    }
  }
  if (coverage <= 0.0) { return float4(0.0); }

  const float3 lit = color / coverage;
  const float alpha = coverage / float(taken);
  const float grain = ditherNoise(in.position.xy) * (1.0 / 255.0);
  return float4(saturate(encodeSRGB(lit) + grain) * alpha, alpha);
}
