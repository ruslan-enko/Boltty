#include <metal_stdlib>
#include "MascotUniforms.h"

using namespace metal;

struct MascotVaryings {
  float4 position [[position]];
  float2 local;
};

vertex MascotVaryings mascotVertex(
  uint id [[vertex_id]],
  constant MascotUniforms &u [[buffer(MascotBufferIndexUniforms)]]
) {
  const float2 clip = float2((id == 1) ? 3.0 : -1.0, (id == 2) ? 3.0 : -1.0);
  MascotVaryings out;
  out.position = float4(clip, 0.0, 1.0);
  out.local = clip * 0.5 * u.frame.xy;
  return out;
}

// MARK: - Stuffing


constant float kCameraDistance = 90.0;

constant float kEyeLine = 1.6;

struct Build {
  float thickness;
  float profile;
  float deepest;
  int shape;
  const device float *field;
};

static inline Build makeBuild(constant MascotUniforms &u, const device float *field) {
  Build b;
  b.thickness = u.build.x;
  b.profile = u.build.y;
  b.deepest = max(field[0], 1e-3);
  b.shape = int(u.shape.y + 0.5);
  b.field = field;
  return b;
}

