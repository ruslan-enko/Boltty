static inline float segmentDistanceSquared(float2 p, float2 start, float2 end) {
  const float2 segment = end - start;
  const float2 fromStart = p - start;
  const float along = clamp(dot(fromStart, segment) / max(dot(segment, segment), 1e-8), 0.0, 1.0);
  const float2 delta = fromStart - segment * along;
  return dot(delta, delta);
}

static inline float sdReferenceOutline(
  float2 p, constant float2 *points,
  constant float4 *bounds, float baseRadius,
  float innerRadius, float outerRadius
) {
  const float r = length(p);
  if (r <= innerRadius) return r - baseRadius;
  if (r > outerRadius + 4.0) return r - outerRadius;
  const float angle = atan2(p.y, p.x);
  const int bin = int(floor((angle + 3.14159265) * (192.0 / 6.28318531)));
  const int radialBin = (bin % 192 + 192) % 192;
  const float2 radialStart = points[radialBin];
  const float2 radialEnd = points[(radialBin + 1) % 192];
  const float2 radialEdge = radialEnd - radialStart;
  const float2 radialPoint = p - radialStart;
  const bool inside = radialEdge.x * radialPoint.y - radialEdge.y * radialPoint.x >= 0.0;
  float nearestSquared = 1e10;
  for (int neighbor = 0; neighbor < 3; ++neighbor) {
    const int endIndex = (radialBin + neighbor) % 192;
    nearestSquared = min(nearestSquared,
      segmentDistanceSquared(p, points[(endIndex + 191) % 192], points[endIndex]));
  }
  for (int group = 0; group < 24; ++group) {
    const float4 box = bounds[group];
    const float2 outside = max(max(box.xy - p, p - box.zw), 0.0);
    if (dot(outside, outside) >= nearestSquared) continue;
    const int first = group * 8;
    float2 start = points[(first + 191) % 192];
    for (int index = first; index < first + 8; ++index) {
      const float2 end = points[index];
      nearestSquared = min(nearestSquared, segmentDistanceSquared(p, start, end));
      start = end;
    }
  }
  return sqrt(nearestSquared) * (inside ? -1.0 : 1.0);
}

static inline float sdBloom(float2 p) {
  return sdReferenceOutline(p, kBloomPolygon, kBloomPolygonBounds,
    15.21311, 6.95418, 17.78489);
}

static inline float sdCapsule(float2 p) {
  return sdReferenceOutline(p, kCapsulePolygon, kCapsulePolygonBounds,
    12.99288, 2.82456, 16.21929);
}

